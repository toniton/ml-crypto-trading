# MCT Trading Bot Environment Configuration Template
# Copy this file to .env and adjust the values accordingly.

# Application Environment (staging | production)
APP_ENV=production
LOG_LEVEL=INFO

# Database Connection (PostgreSQL)
DATABASE_CONNECTION_HOST=localhost:5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DATABASE=trading

# Exchange API Credentials
CRYPTO_DOT_COM__API_KEY=your_api_key_here
CRYPTO_DOT_COM__SECRET_KEY=your_secret_key_here

# CCXT Exchange Providers (Optional / As needed)
CCXT_PROVIDERS__BINANCE__API_KEY=your_binance_api_key
CCXT_PROVIDERS__BINANCE__SECRET_KEY=your_binance_secret_key

# LLM Providers (Optional / For AI Subsystem)
LLM_PROVIDER__DEEPSEEK__API_KEY=your_deepseek_api_key
LLM_PROVIDER__GEMINI__API_KEY=your_gemini_api_key
LLM_PROVIDER__GROQ__API_KEY=your_groq_api_key
